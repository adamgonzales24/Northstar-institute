#!/usr/bin/env bash
# Serve Northstar on this Wi-Fi so an iPhone or iPad can Add to Home Screen.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export PATH="${HOME}/.local/node/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}"
cd "$ROOT"

if [[ ! -f dist/index.html ]]; then
  if ! command -v npm >/dev/null 2>&1; then
    echo "Need a production build (dist/) or Node.js to create one."
    exit 1
  fi
  npm run build
fi

exec python3 scripts/serve-ios.py "$@"
