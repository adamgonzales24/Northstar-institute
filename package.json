{
  "name": "northstar-institute",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "productName": "Northstar Institute",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "smoke": "node scripts/smoke.mjs",
    "desktop": "npm run build && electron .",
    "desktop:install": "npm run build && node scripts/install-desktop.mjs",
    "desktop:pack": "npm run build && node scripts/pack-portable.mjs",
    "ios": "npm run build && python3 scripts/serve-ios.py",
    "ios:serve": "python3 scripts/serve-ios.py",
    "mobile": "vite --host --port 5173"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.1.1",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2"
  }
}
